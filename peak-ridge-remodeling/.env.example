# Copy this file to .env.local and fill in values before running the contact form

# Resend API key — get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives estimate requests
RESEND_TO_EMAIL=hello@peakridgeremodeling.com

# Optional: reply-to email for the sender confirmation
RESEND_FROM_EMAIL=noreply@peakridgeremodeling.com
